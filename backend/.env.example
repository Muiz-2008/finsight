ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:5173"]

# "local": deterministic synthetic prices, no network (default — used by
# tests/CI/demos). "yfinance": real market data, requires the `yfinance`
# extra (pip install -e ".[yfinance]").
MARKET_DATA_PROVIDER=local
